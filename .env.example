APP_NAME="Streamiung EF Local"
APP_ENV=local
APP_KEY=base64:KOxxWWnQQW0y8jHUZFuCqWGKcgCXtR0X0c9r0NEadN4=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=streaming_ef
DB_USERNAME=sail
DB_PASSWORD=password


BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# DVR S3 Storage Configuration
# Used for storing and retrieving recorded stream segments from SRS DVR
# Local dev defaults: MinIO running in docker-compose (sail up)
# For production replace with real S3/Hetzner Object Storage credentials.
DVR_AWS_ACCESS_KEY_ID=minio
DVR_AWS_SECRET_ACCESS_KEY=minio123
DVR_AWS_BUCKET=recording
DVR_AWS_ENDPOINT=http://minio:9000
DVR_AWS_URL=http://localhost:9000/recording
DVR_AWS_USE_PATH_STYLE_ENDPOINT=true

# System streamkey for internal operations (thumbnails, monitoring, etc.)
# Generate a secure random string for production
STREAM_SYSTEM_STREAMKEY=

# Ingest ports — both protocols are active simultaneously; OBS operator chooses either one.
# RTMP (TCP 1935):  Server rtmp://host:1935/live  |  Stream Key: <your-key>
# SRT  (UDP 10080): Server srt://host:10080       |  Stream Key: #!::r=live/<your-key>,m=publish
# SRT shaves ~2-3 s off RTMP latency and recovers gracefully from packet loss.
# Override the host ports if you have conflicts:
# FORWARD_SRS_RTMP_PORT=1935
# FORWARD_SRS_SRT_PORT=10080

# DVR / VOD processing
# Event identifier used in the S3 path (e.g. ef29 for Eurofurence 29)
DVR_EVENT_SLUG=event
# S3 base path prefix for finished VOD recordings (matches S3_BASE_PATH in dvr-process.sh)
DVR_VOD_BASE_PATH=on-demand
# Minutes to wait after show ends before starting DVR extraction (SRS writes 10-min chunks)
# Only used by the legacy dvr-process.sh pipeline; the live-archive approach uses VOD_CREATION_DELAY_SECONDS.
DVR_PROCESSING_DELAY_MINUTES=12

# VOD: archive FFmpeg writes segments here during the stream;
# upload job reads from the same path (shared hls-content volume).
HLS_ARCHIVE_BASE_DIR=/var/www/hls/archive
# Flag files used to start/stop archive recording (created on Go Live / End Stream).
HLS_ARCHIVE_FLAGS_DIR=/var/www/hls/archive-flags
# Pause flag files used by the "Pause VOD Recording" admin button (intermissions).
HLS_ARCHIVE_PAUSE_DIR=/var/www/hls/archive-pause
# Short delay so archive FFmpeg can write #EXT-X-ENDLIST before the upload job runs.
VOD_CREATION_DELAY_SECONDS=15

# Local streaming server override for specific IP subnets
# When client IPs match these subnets, force use of LOCAL_STREAMING_HOSTNAME server
# Use CIDR notation, e.g., 192.168.1.0/24 for IPv4, 2001:db8::/64 for IPv6
LOCAL_STREAMING_IPV4_SUBNET=
LOCAL_STREAMING_IPV6_SUBNET=
LOCAL_STREAMING_HOSTNAME=

REVERB_APP_ID=my-app-id        # any string
REVERB_APP_KEY=my-app-key      # any string
REVERB_APP_SECRET=my-app-secret  # any string
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_MAX_REQUEST_SIZE=250000
REVERB_APP_MAX_MESSAGE_SIZE=100000
REVERB_SCALING_ENABLED=false
REVERB_PULSE_INGEST_INTERVAL=15

PUSHER_APP_ID="${REVERB_APP_ID}"
PUSHER_APP_KEY="${REVERB_APP_KEY}"
PUSHER_APP_SECRET="${REVERB_APP_SECRET}"
PUSHER_HOST="${REVERB_HOST}"
PUSHER_PORT="${REVERB_PORT}"
PUSHER_SCHEME="${REVERB_SCHEME}"
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_PUSHER_APP_KEY="${REVERB_APP_KEY}"
VITE_PUSHER_HOST="${REVERB_HOST}"
VITE_PUSHER_PORT="${REVERB_PORT}"
VITE_PUSHER_SCHEME="${REVERB_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# DNS Configuration for dynamic updates
DNS_SERVER=85.199.154.53
DNS_ZONE=stream.eurofurence.org
DNS_KEY_NAME=stream-ddns
DNS_KEY_ALGORITHM=hmac-sha256
DNS_KEY_SECRET=
DNS_TTL=60

# Recording API Authentication
RECORDING_API_KEY=your-secure-api-key-here
